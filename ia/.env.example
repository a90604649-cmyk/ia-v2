# Copia este archivo como .env y coloca tu clave local de OmniRoute.
# OMNIROUTE_API_KEY es la clave local de OmniRoute, no la clave del proveedor NVIDIA.
# Nunca subas el archivo .env real a GitHub.
OMNIROUTE_API_KEY=pega_tu_clave_local_aqui
OMNIROUTE_URL=http://127.0.0.1:20128/v1/chat/completions
OMNIROUTE_MODEL=nvidia/nvidia/nemotron-3-ultra-550b-a55b
# Opcional: usa solo un ID exacto de modelo con entrada de imagen visible en GET /v1/models.
OMNIROUTE_VISION_MODEL=
# Alternativa: API visual directa de NVIDIA, independiente de las rutas/modelos de OmniRoute.
# Requiere una clave NVIDIA propia; no reutilices OMNIROUTE_API_KEY.
NVIDIA_API_KEY=
NVIDIA_VISION_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Modelo alternativo de visión si el endpoint principal está degradado.
NVIDIA_VISION_FALLBACK_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_VISION_TIMEOUT_MS=90000
# Nemotron Omni ya agotó el tiempo límite; deja que el fallback se active en 25 s.
NVIDIA_VISION_PRIMARY_TIMEOUT_MS=25000
# Opcional: API Key de Open Cloud con permiso creator-store-product:read para la búsqueda moderna de Creator Store.
# Si se deja vacía, el servidor intenta los endpoints públicos de búsqueda legacy.
ROBLOX_CREATOR_STORE_API_KEY=
OMNIROUTE_TIMEOUT_MS=300000
OMNIROUTE_REASONING_EFFORT=none

PORT=3000
PROJECT_CONTEXT_PORT=3001
PROJECT_CONTEXT_HOST=0.0.0.0
BRIDGE_INPUT_PORT=3030
