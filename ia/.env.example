# Copia este archivo como .env y coloca tu clave local de OmniRoute.
# OMNIROUTE_API_KEY es la clave local de OmniRoute, no la clave del proveedor NVIDIA.
# Nunca subas el archivo .env real a GitHub.
OMNIROUTE_API_KEY=pega_tu_clave_local_aqui
OMNIROUTE_URL=http://127.0.0.1:20128/v1/chat/completions
OMNIROUTE_MODEL=nvidia/nvidia/nemotron-3-ultra-550b-a55b
# Modelo multimodal utilizado únicamente cuando adjuntas una imagen de referencia.
OMNIROUTE_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OMNIROUTE_TIMEOUT_MS=300000
OMNIROUTE_REASONING_EFFORT=none

PORT=3000
PROJECT_CONTEXT_PORT=3001
PROJECT_CONTEXT_HOST=0.0.0.0
BRIDGE_INPUT_PORT=3030
